---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, pillars, works, articleIdeas } from '../data/site';
import '../styles/catalog.css';
---
<BaseLayout>
  <header class="site-header">
    <div class="site-shell nav">
      <a class="brand" href="/">TED JOHNSON <span>WORKS</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#work">Works</a>
        <a href="#articles">Stories & Articles</a>
        <a href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">The Book Site</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="site-shell">
        <div class="hero-panel">
          <div class="hero-copy">
            <p class="eyebrow">{site.hero.eyebrow}</p>
            <h1>{site.hero.title}</h1>
            <p class="hero-lede">{site.hero.subtitle}</p>
            <p><span class="highlight"><strong>Useful first. Commercial second.</strong></span></p>
            <div class="actions">
              <a class="button button-gold" href="#work">Explore the Work</a>
              <a class="button button-light" href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">Start With the Story</a>
            </div>
          </div>
          <div class="hero-art" aria-label="Ted Johnson Works monogram">
            <div class="hero-orbit" aria-hidden="true"></div>
            <div class="hero-monogram" aria-hidden="true">TJ</div>
            <p class="hero-caption">Author · Technologist · Teacher · Builder</p>
          </div>
        </div>
        <div class="cred-strip" aria-label="Ted Johnson background">
          <div><strong>Story & Meaning</strong><span>Books, lived experience, hope and practical compassion</span></div>
          <div><strong>Technology & Learning</strong><span>Plain-English tools, teaching, AI and practical help</span></div>
          <div><strong>Strength & Practice</strong><span>Stewardship, training, discipline, martial arts and food</span></div>
        </div>
      </div>
    </section>

    <section id="work" class="catalog-section">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">TED JOHNSON WORKS</p>
          <h2>Explore the Work</h2>
          <p>Three areas organize the subjects. The labels on each card tell you what form the work takes — book, guide, service, movement, or project.</p>
        </div>

        <nav class="category-nav" aria-label="Work areas">
          {pillars.map((pillar) => (
            <a href={`#${pillar.id}`}>{pillar.label}</a>
          ))}
        </nav>

        <div class="catalog-stack">
          {pillars.map((pillar) => {
            const pillarWorks = works.filter((work) => work.pillar === pillar.id);
            return (
              <section class="work-group" id={pillar.id} aria-labelledby={`${pillar.id}-title`}>
                <div class="group-heading">
                  <div>
                    <p class="eyebrow">{pillar.eyebrow}</p>
                    <h3 id={`${pillar.id}-title`}>{pillar.label}</h3>
                  </div>
                  <p>{pillar.description}</p>
                </div>

                <div class="work-grid">
                  {pillarWorks.map((item) => (
                    <article class:list={["work-card", { featured: item.featured }]}>
                      <div class="work-card-topline">
                        <span class="status-badge">{item.status}</span>
                        <span class="work-type">{item.type}</span>
                      </div>
                      <h4>{item.title}</h4>
                      <p>{item.description}</p>
                      {item.highlight && <p class="work-highlight"><strong>{item.highlight}</strong></p>}
                      {item.primaryUrl && (
                        <div class="card-actions">
                          <a class="button button-gold" href={item.primaryUrl} target="_blank" rel="noopener">{item.primaryLabel}</a>
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </div>
    </section>

    <section class="dark-section" id="articles">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">STORIES & ARTICLES</p>
          <h2>Useful ideas connect the three areas.</h2>
          <p>Articles can begin with one subject and naturally lead readers into another part of the work without forcing everything into the same box.</p>
        </div>
        <ul class="idea-list">
          {articleIdeas.map((idea) => <li><strong>{idea}</strong></li>)}
        </ul>
      </div>
    </section>

    <section>
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">TED’S PICKS</p>
          <h2>Things worth paying for.</h2>
          <p>Recommendations can cross all three areas, but only when something has earned its place.</p>
        </div>
        <div class="card-grid two">
          <article class="card">
            <p class="tag">HOW RECOMMENDATIONS WORK</p>
            <h3>If I wouldn’t recommend it to a friend, it doesn’t belong here.</h3>
            <p>Some future recommendations may include affiliate links. Those relationships will be identified clearly, and the recommendation comes first.</p>
          </article>
          <article class="card">
            <p class="tag">THE STANDARD</p>
            <h3>Useful first. Commercial second.</h3>
            <p>This site can point to Amazon, Payhip, and other trusted platforms without turning every page into a checkout screen.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-row">
      <p>© {new Date().getFullYear()} Ted Johnson Works. Built to grow with the work.</p>
      <div class="footer-links">
        <a href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">The Light in the Window</a>
        <a href="https://leaveonelighton.org" target="_blank" rel="noopener">Leave One Light On</a>
        <a href="#main">Back to top</a>
      </div>
    </div>
  </footer>
</BaseLayout>
