---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, pillars, works } from '../data/site';
import '../styles/catalog.css';

const publishedArticles = [
  {
    title: 'AI for People Who Don’t Want to Become AI Experts',
    url: '/articles/ai-for-people-who-dont-want-to-become-ai-experts',
  },
  {
    title: 'How I Built TedJohnsonWorks.com Without Hiring an Agency',
    url: '/articles/how-i-built-ted-johnson-works',
  },
  {
    title: 'How I Use Payhip to Sell Practical Guides',
    url: '/articles/how-i-use-payhip-to-sell-practical-guides',
  },
];
---
<BaseLayout>
  <header class="site-header">
    <div class="site-shell nav">
      <a class="brand" href="/">TED JOHNSON <span>WORKS</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="/start">Start Here</a>
        <a href="#work">Works</a>
        <a href="#practical-ai">Practical AI</a>
        <a href="/photography">Photography</a>
        <a href="#articles">Stories & Articles</a>
        <a href="/picks">Ted’s Picks</a>
        <a href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">The Book Site</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="site-shell">
        <div class="hero-panel">
          <div class="hero-copy">
            <p class="eyebrow">{site.hero.eyebrow}</p>
            <h1>{site.hero.title}</h1>
            <p class="hero-lede">{site.hero.subtitle}</p>
            <p><span class="highlight"><strong>Useful first. Commercial second.</strong></span></p>
            <p class="hero-ai-note"><strong>Practical AI for real people</strong> — useful, understandable, and grounded.</p>
            <div class="actions">
              <a class="button button-gold" href="/start">Start Here</a>
              <a class="button button-light" href="#work">Explore the Work</a>
            </div>
          </div>
          <div class="hero-art" aria-label="Ted Johnson Works monogram">
            <div class="hero-orbit" aria-hidden="true"></div>
            <div class="hero-monogram" aria-hidden="true">TJ</div>
            <p class="hero-caption">Author · Technologist · Teacher · Photographer · Builder</p>
          </div>
        </div>
        <div class="cred-strip" aria-label="Ted Johnson background">
          <div><strong>Story & Meaning</strong><span>Books, lived experience, hope and practical compassion</span></div>
          <div><strong>Technology, AI & Learning</strong><span>Plain-English tools, teaching, practical AI and direct help</span></div>
          <div><strong>Photography & Visual Stories</strong><span>People, places, details and moments seen through Ted’s camera</span></div>
          <div><strong>Strength & Practice</strong><span>Stewardship, training, discipline, martial arts and food</span></div>
        </div>
      </div>
    </section>

    <section class="freedom-250-section" aria-labelledby="freedom-250-home-title">
      <div class="site-shell">
        <div class="freedom-250-banner">
          <div>
            <p class="eyebrow">2026 · AMERICA’S 250TH YEAR</p>
            <h2 id="freedom-250-home-title">Freedom 250: an American year worth seeing.</h2>
            <p>An independent Ted Johnson Works photography and storytelling special — everyday people, places, work, freedom, and community through Ted’s camera.</p>
          </div>
          <a class="button button-gold" href="/photography#freedom-250">Explore Freedom 250</a>
        </div>
      </div>
    </section>

    <section id="work" class="catalog-section">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">TED JOHNSON WORKS</p>
          <h2>Explore the Work</h2>
          <p>Four areas organize the subjects. The labels on each card tell you what form the work takes — book, guide, service, photography, movement, or project.</p>
        </div>

        <nav class="category-nav" aria-label="Work areas">
          {pillars.map((pillar) => (
            <a href={`#${pillar.id}`}>{pillar.label}</a>
          ))}
        </nav>

        <div class="catalog-stack">
          {pillars.map((pillar) => {
            const pillarWorks = works.filter((work) => work.pillar === pillar.id);
            return (
              <section class="work-group" id={pillar.id} aria-labelledby={`${pillar.id}-title`}>
                <div class="group-heading">
                  <div>
                    <p class="eyebrow">{pillar.eyebrow}</p>
                    <h3 id={`${pillar.id}-title`}>{pillar.label}</h3>
                  </div>
                  <p>{pillar.description}</p>
                </div>

                <div class="work-grid">
                  {pillarWorks.map((item) => (
                    <article
                      id={item.id}
                      class:list={["work-card", { featured: item.featured, "ai-focus": item.aiFocus, "photo-focus": item.photoFocus }]}
                    >
                      <div class="work-card-topline">
                        <span class="status-badge">{item.status}</span>
                        <span class="work-type">{item.type}</span>
                      </div>
                      <h4>{item.title}</h4>
                      <p>{item.description}</p>
                      {item.highlight && <p class="work-highlight"><strong>{item.highlight}</strong></p>}
                      {item.primaryUrl && (
                        <div class="card-actions">
                          <a
                            class="button button-gold"
                            href={item.primaryUrl}
                            target={item.primaryUrl.startsWith('http') ? '_blank' : undefined}
                            rel={item.primaryUrl.startsWith('http') ? 'noopener' : undefined}
                          >{item.primaryLabel}</a>
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </div>
    </section>

    <section class="dark-section" id="articles">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">STORIES & ARTICLES</p>
          <h2>Useful ideas connect the four areas.</h2>
          <p>Practical articles can bring readers in through a specific question, then lead them naturally to a book, guide, service, photograph, or recommendation when it actually fits.</p>
        </div>
        <ul class="idea-list">
          {publishedArticles.map((article) => (
            <li><a href={article.url}><strong>{article.title}</strong></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="picks-preview">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">TED’S PICKS</p>
          <h2>Buy less. Choose better.</h2>
          <p>A separate recommendation board for tools, books, photography gear, training gear, kitchen equipment, and other things that have earned a place — kept apart from the main body of work.</p>
        </div>
        <div class="card-grid two">
          <article class="card">
            <p class="tag">THE FILTER</p>
            <h3>What problem does it solve?</h3>
            <p>Every recommendation should explain who it helps, why it earned a spot, and when I would skip it.</p>
          </article>
          <article class="card">
            <p class="tag">THE BOARD</p>
            <h3>Ted’s Picks</h3>
            <p>Recommendations, useful buying guidance, and clearly disclosed paid links live on their own page.</p>
            <div class="card-actions">
              <a class="button button-gold" href="/picks">Explore Ted’s Picks</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-row">
      <p>© {new Date().getFullYear()} Ted Johnson Works. Built to grow with the work.</p>
      <div class="footer-links">
        <a href="/start">Start Here</a>
        <a href="/photography">Photography</a>
        <a href="/picks">Ted’s Picks</a>
        <a href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">The Light in the Window</a>
        <a href="https://leaveonelighton.org" target="_blank" rel="noopener">Leave One Light On</a>
        <a href="#main">Back to top</a>
      </div>
    </div>
  </footer>
</BaseLayout>
