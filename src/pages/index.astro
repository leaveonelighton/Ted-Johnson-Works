---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, workCategories, works, workbench, articleIdeas } from '../data/site';
import '../styles/catalog.css';

const publishedCategories = workCategories.filter((category) => category.id !== 'workbench');
---
<BaseLayout>
  <header class="site-header">
    <div class="site-shell nav">
      <a class="brand" href="/">TED JOHNSON <span>WORKS</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#work">Works</a>
        <a href="#workbench">Workbench</a>
        <a href="#articles">Stories & Articles</a>
        <a href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">The Book Site</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="site-shell">
        <div class="hero-panel">
          <div class="hero-copy">
            <p class="eyebrow">{site.hero.eyebrow}</p>
            <h1>{site.hero.title}</h1>
            <p class="hero-lede">{site.hero.subtitle}</p>
            <p><span class="highlight"><strong>Useful first. Commercial second.</strong></span></p>
            <div class="actions">
              <a class="button button-gold" href="#work">Explore the Work</a>
              <a class="button button-light" href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">Start With the Story</a>
            </div>
          </div>
          <div class="hero-art" aria-label="Ted Johnson Works monogram">
            <div class="hero-orbit" aria-hidden="true"></div>
            <div class="hero-monogram" aria-hidden="true">TJ</div>
            <p class="hero-caption">Author · Technologist · Teacher · Builder</p>
          </div>
        </div>
        <div class="cred-strip" aria-label="Ted Johnson background">
          <div><strong>Decades in Technology</strong><span>Hands-on work, testing, support and problem solving</span></div>
          <div><strong>Teacher & Practical Guide</strong><span>Plain-English help designed for real people</span></div>
          <div><strong>Author & Builder</strong><span>Books, tools, stories and projects built from experience</span></div>
        </div>
      </div>
    </section>

    <section id="work" class="catalog-section">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">TED JOHNSON WORKS</p>
          <h2>Explore the Work</h2>
          <p>Books, technology, practical guides, services, and lessons built from a lifetime of learning by doing.</p>
        </div>

        <nav class="category-nav" aria-label="Work categories">
          {workCategories.map((category) => (
            <a href={`#${category.id}`}>{category.label}</a>
          ))}
        </nav>

        <div class="catalog-stack">
          {publishedCategories.map((category) => {
            const categoryWorks = works.filter((work) => work.category === category.id);
            return (
              <section class="work-group" id={category.id} aria-labelledby={`${category.id}-title`}>
                <div class="group-heading">
                  <div>
                    <p class="eyebrow">{category.label}</p>
                    <h3 id={`${category.id}-title`}>{category.label}</h3>
                  </div>
                  <p>{category.description}</p>
                </div>

                <div class="work-grid">
                  {categoryWorks.map((item) => (
                    <article class="work-card">
                      <div class="work-card-topline">
                        <span class="status-badge">{item.status}</span>
                        <span class="work-type">{item.categoryLabel}</span>
                      </div>
                      <h4>{item.title}</h4>
                      <p>{item.description}</p>
                      {item.highlight && <p class="work-highlight"><strong>{item.highlight}</strong></p>}
                      <div class="card-actions">
                        <a class="button button-gold" href={item.primaryUrl} target="_blank" rel="noopener">{item.primaryLabel}</a>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </div>
    </section>

    <section id="workbench" class="workbench-section">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">FROM THE WORKBENCH</p>
          <h2>The rest of the work has a place to grow.</h2>
          <p>Strength, martial arts, food, and future projects belong here without pretending unfinished work is already for sale.</p>
        </div>
        <div class="shelf-grid three">
          {workbench.map((item) => (
            <article class="shelf" id={item.id}>
              <p class="eyebrow">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <p class="status">{item.status}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dark-section" id="articles">
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">STORIES & ARTICLES</p>
          <h2>Useful ideas connect the shelves.</h2>
          <p>Practical writing gives each subject room to stand on its own while still belonging to one body of work.</p>
        </div>
        <ul class="idea-list">
          {articleIdeas.map((idea) => <li><strong>{idea}</strong></li>)}
        </ul>
      </div>
    </section>

    <section>
      <div class="site-shell">
        <div class="section-head">
          <p class="eyebrow">TED’S PICKS</p>
          <h2>Things worth paying for.</h2>
          <p>Technology, creator tools, training, martial arts, and cooking recommendations will earn their place here one at a time.</p>
        </div>
        <div class="card-grid two">
          <article class="card">
            <p class="tag">HOW RECOMMENDATIONS WORK</p>
            <h3>If I wouldn’t recommend it to a friend, it doesn’t belong here.</h3>
            <p>Some future recommendations may include affiliate links. Those relationships will be identified clearly, and the recommendation comes first.</p>
          </article>
          <article class="card">
            <p class="tag">THE STANDARD</p>
            <h3>Useful first. Commercial second.</h3>
            <p>This site can point to Amazon, Payhip, and other trusted platforms without turning every page into a checkout screen.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-row">
      <p>© {new Date().getFullYear()} Ted Johnson Works. Built to grow with the work.</p>
      <div class="footer-links">
        <a href="https://thelightinthewindowbook.com" target="_blank" rel="noopener">The Light in the Window</a>
        <a href="#main">Back to top</a>
      </div>
    </div>
  </footer>
</BaseLayout>
