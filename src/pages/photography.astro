---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/photography.css';

const title = 'Photography & Visual Stories | Ted Johnson Works';
const description = 'A developing collection of original photography and visual stories by Theodore “Ted” Johnson, including the 2026 Freedom 250 project.';

const portfolioAreas = [
  ['People & Character', 'Portraits, expressions, work, and the human details that make a frame matter.'],
  ['Places & Landscapes', 'Roads, towns, landscapes, architecture, weather, and the character of a place.'],
  ['Work & Machines', 'Tools, technology, vehicles, workshops, hands at work, and the beauty of practical things.'],
  ['Details & Texture', 'Small things most people pass by — light, texture, wear, shape, color, and evidence of use.'],
  ['Everyday America', 'Ordinary scenes that say something about how people live, work, gather, travel, and belong.'],
  ['Freedom 250', 'A 2026 special series built around America’s 250th year and photographed through Ted’s own lens.'],
];
---
<BaseLayout title={title} description={description}>
  <header class="site-header">
    <div class="site-shell nav">
      <a class="brand" href="/">TED JOHNSON <span>WORKS</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="/">Works</a>
        <a href="/start">Start Here</a>
        <a href="/photography" aria-current="page">Photography</a>
        <a href="/picks">Ted’s Picks</a>
        <a href="/#articles">Stories & Articles</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="photo-hero">
      <div class="site-shell">
        <div class="photo-hero-panel">
          <div>
            <p class="eyebrow">DEVELOPING VISUAL WORK</p>
            <h1>Light. Place. People. The moment that almost got away.</h1>
            <p class="photo-dek">Photography is a growing creative lane inside Ted Johnson Works. This page is a place to develop the work from real photographs without turning it into a professional title before it has earned that role.</p>
            <div class="actions">
              <a class="button button-gold" href="#portfolio">Explore the Developing Portfolio</a>
              <a class="button button-light" href="#freedom-250">Freedom 250</a>
            </div>
          </div>
          <div class="camera-mark" aria-label="Ted Johnson Works visual work monogram">
            <span aria-hidden="true">TJ</span>
          </div>
        </div>
      </div>
    </section>

    <section id="portfolio">
      <div class="site-shell">
        <div class="photo-intro">
          <p class="eyebrow">DEVELOPING PORTFOLIO</p>
          <h2>Original photographs. No stock-photo wall.</h2>
          <p>The structure is ready. Ted’s photographs will replace these portfolio markers as the first collection is selected, so the page grows from real work rather than filler.</p>
        </div>

        <div class="photo-grid" aria-label="Photography portfolio areas">
          {portfolioAreas.map(([title, text]) => (
            <article class="photo-slot">
              <strong>{title}</strong>
              <span>{text}</span>
            </article>
          ))}
        </div>

        <p class="photo-note"><strong>Coming next:</strong> selected photographs and short captions. Prints or licensing can be considered later if the work and audience justify it.</p>
      </div>
    </section>

    <section class="freedom-project" id="freedom-250">
      <div class="site-shell">
        <div>
          <p class="eyebrow">2026 · AMERICA’S 250TH YEAR</p>
          <h2>Freedom 250: An American Year in Photographs</h2>
          <p>This independent Ted Johnson Works project celebrates America’s 250th year through everyday life: people at work, main streets, open roads, neighborhoods, tools, gatherings, landscapes, flags, weather, machines, quiet moments, and the freedom to build a life.</p>
          <p>The goal is not staged patriotism. It is a photographic record of the country as Ted encounters it — grounded, human, sometimes imperfect, and worth seeing.</p>
          <p><strong>Possible future forms:</strong> a curated online collection, selected prints, a photo essay, or a digital edition — only as the body of work develops.</p>
        </div>
        <div class="freedom-number" aria-hidden="true">250</div>
      </div>
    </section>

    <section class="photo-business">
      <div class="site-shell">
        <div class="photo-intro">
          <p class="eyebrow">FUTURE POSSIBILITIES</p>
          <h2>Let the work earn the next step.</h2>
          <p>For now, the priority is the portfolio. Commercial options stay secondary until there is enough original work and audience interest to justify them.</p>
        </div>
        <div class="business-grid">
          <article class="business-card">
            <h3>Selected Prints</h3>
            <p>A future option for photographs that prove strong enough to stand on their own.</p>
          </article>
          <article class="business-card">
            <h3>Image Licensing</h3>
            <p>A future option for images with useful editorial or commercial subject matter, if demand develops.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-row">
      <p>© {new Date().getFullYear()} Ted Johnson Works. Developing visual work by Theodore “Ted” Johnson.</p>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/start">Start Here</a>
        <a href="/picks">Ted’s Picks</a>
        <a href="#main">Back to top</a>
      </div>
    </div>
  </footer>
</BaseLayout>
