---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ted Johnson Works | Official Website of Theodore “Ted” Johnson',
  description = 'The official digital home of Theodore “Ted” Johnson — author, technologist, teacher, builder, and lifelong student of practical work.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Theodore Johnson',
  alternateName: 'Ted Johnson',
  url: 'https://tedjohnsonworks.com/',
  jobTitle: ['Author', 'Technologist', 'Teacher'],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ted Johnson Works',
  url: 'https://tedjohnsonworks.com/',
  description,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b132b" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ted Johnson Works" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
